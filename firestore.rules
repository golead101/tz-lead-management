rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Function to check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Function to check if the caller is an Admin
    function isAdmin() {
      return isAuthenticated() && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // users collection:
    // Any user can read their own profile.
    // Only Admin can read everyone or create/edit users.
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // settings collection:
    // Any user (even unauthenticated) can read the public live_form configuration.
    // Only Admin can read other configurations (like integrations) and write settings.
    match /settings/{documentId} {
      allow read: if (documentId == 'live_form') || isAdmin();
      allow write: if isAdmin();
    }

    // googleAdsLogs collection:
    // Only Admin can read/write API validation/sync logs.
    match /googleAdsLogs/{documentId} {
      allow read, write: if isAdmin();
    }

    // i-frame collection:
    // Public can submit leads, but only authenticated users can read/modify them.
    match /i-frame/{documentId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // crm collections (leads, courses, pipelineStages, customFields, etc.):
    // Only logged in users can read and write.
    match /leads/{documentId} {
      allow read, write: if isAuthenticated();
    }
    match /courses/{documentId} {
      allow read, write: if isAuthenticated();
    }
    match /pipelineStages/{documentId} {
      allow read, write: if isAuthenticated();
    }
    match /customFields/{documentId} {
      allow read, write: if isAuthenticated();
    }
  }
}
